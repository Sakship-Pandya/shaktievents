# ---- Public (inlined into the browser bundle) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
# Fallbacks only. The SiteSettings row edited at /admin/settings is what the
# public pages actually read; these cover the case where it has not been saved.
NEXT_PUBLIC_PHONE_PRIMARY=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Server ----
DATABASE_URL=postgresql://USER@localhost:5432/shaktimandap_dev?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Fallback only — the token is normally pasted into
# /admin/settings/features, so it can be replaced without a deploy.
INSTAGRAM_TOKEN=
WHATSAPP_CLOUD_TOKEN=
REVALIDATE_SECRET=

# ---- Seed only (not read at runtime) ----
# Set SEED_ADMIN_EMAIL to have `pnpm db:seed` create the first ADMIN user.
# Leave SEED_ADMIN_PASSWORD blank and the seed prints a generated one once.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Sender for enquiry notifications. Needs a domain verified with Resend;
# without it the default Resend sandbox sender is used.
ENQUIRY_FROM_EMAIL=
